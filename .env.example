# =============================================================================
# MEGAN POS - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local to git!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (server-side only, NEVER expose to client)
# Used for server actions that bypass RLS (subscriptions, billing, etc.)
# Get from: Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# DATABASE CONNECTION
# -----------------------------------------------------------------------------
# Connection pooling URL (for app runtime - uses port 6543)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Direct connection URL (for migrations - uses port 5432)
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# APPLICATION URL
# -----------------------------------------------------------------------------
# Base URL for payment redirects and callbacks
# Development (with ngrok): https://your-subdomain.ngrok-free.dev
# Development (local only): http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY
# -----------------------------------------------------------------------------
# Options: 'midtrans', 'xendit'
PAYMENT_GATEWAY=midtrans

# -----------------------------------------------------------------------------
# MIDTRANS (https://midtrans.com)
# -----------------------------------------------------------------------------
# Get from: Midtrans Dashboard → Settings → Access Keys
# Sandbox: https://dashboard.sandbox.midtrans.com
# Production: https://dashboard.midtrans.com

MIDTRANS_SERVER_KEY=SB-Mid-server-your_key_here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_key_here

# false = sandbox (https://app.sandbox.midtrans.com)
# true = production (https://app.midtrans.com)
MIDTRANS_IS_PRODUCTION=false

# -----------------------------------------------------------------------------
# XENDIT (https://xendit.co) — optional, only if PAYMENT_GATEWAY=xendit
# -----------------------------------------------------------------------------
# XENDIT_API_KEY=xnd_development_your_key_here
# XENDIT_WEBHOOK_SECRET=whsec_your_secret_here

# -----------------------------------------------------------------------------
# EMAIL SERVICE
# -----------------------------------------------------------------------------
# Google Apps Script URL for sending emails (OTP, notifications)
# Deploy script as web app, then paste URL here
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_EMAIL_URL=https://script.google.com/macros/s/your-script-id/exec
