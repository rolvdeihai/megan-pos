# =============================================================================
# MEGAN POS - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local to git!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (server-side only, NEVER expose to client)
# Get from: Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# DATABASE CONNECTION
# -----------------------------------------------------------------------------
# Database password (used for connection strings below)
SUPABASE_DB_PASSWORD=your-database-password-here

# Connection pooling URL (for app runtime - uses port 6543)
# Format: postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection URL (for migrations - uses port 5432)
# Format: postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# APPLICATION URL
# -----------------------------------------------------------------------------
# Base URL for the application (used for redirects, callbacks, etc.)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY SELECTION
# -----------------------------------------------------------------------------
# Choose which payment gateway to use
# Options: 'simulate' (default), 'xendit', 'midtrans'
PAYMENT_GATEWAY=simulate

# -----------------------------------------------------------------------------
# XENDIT PAYMENT GATEWAY
# -----------------------------------------------------------------------------
# Required when PAYMENT_GATEWAY=xendit
# Get these from: Xendit Dashboard → Settings → API Keys
# Docs: https://developers.xendit.co/api-reference/

# API Key (use xnd_development_ prefix for sandbox, xnd_production_ for live)
XENDIT_API_KEY=xnd_development_your_key_here

# Webhook Secret for callback verification
# Get from: Xendit Dashboard → Settings → Webhooks
XENDIT_WEBHOOK_SECRET=whsec_your_secret_here

# -----------------------------------------------------------------------------
# MIDTRANS PAYMENT GATEWAY
# -----------------------------------------------------------------------------
# Required when PAYMENT_GATEWAY=midtrans
# Get these from: Midtrans Dashboard → Settings → Access Keys
# Docs: https://docs.midtrans.com/en/welcome/index.html

# Server Key (server-side only)
MIDTRANS_SERVER_KEY=SB-Mid-server-your_key_here

# Client Key (safe to expose to frontend)
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_key_here

# Set to 'true' for production, 'false' for sandbox
MIDTRANS_IS_PRODUCTION=false

# -----------------------------------------------------------------------------
# EMAIL SERVICE (Google Apps Script)
# -----------------------------------------------------------------------------
# Deploy your Google Apps Script as web app and paste the URL here
# This is used for sending OTP emails and order notifications
# Both server-side and client-side variables are supported
GOOGLE_APPS_SCRIPT_EMAIL_URL=https://script.google.com/macros/s/your-script-id/exec
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_EMAIL_URL=https://script.google.com/macros/s/your-script-id/exec

# -----------------------------------------------------------------------------
# OPTIONAL: OPENAI (for Supabase Studio AI features)
# -----------------------------------------------------------------------------
# Only needed if using Supabase Studio's AI features
# OPENAI_API_KEY=your-openai-api-key-here
